<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Entra Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        :root {
            --primary-color: #0078d4;
            --secondary-color: #106ebe;
            --success-color: #107c10;
            --warning-color: #ffb900;
            --danger-color: #d13438;
            --dark-color: #201f1e;
            --light-color: #f3f2f1;
            --sidebar-width: 260px;
        }

        body {
            background-color: #faf9f8;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            padding-top: 56px;
        }

        /* ─── Navbar ─────────────────────────────────── */
        .navbar-brand { font-weight: 600; }
        .navbar {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            z-index: 1030;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
        }

        /* ─── Sidebar ────────────────────────────────── */
        .sidebar {
            width: var(--sidebar-width);
            min-height: calc(100vh - 56px);
            background: #fff;
            border-right: 1px solid #edebe9;
            box-shadow: 2px 0 8px rgba(0,0,0,0.04);
            flex-shrink: 0;
            position: sticky;
            top: 56px;
            height: calc(100vh - 56px);
            overflow-y: auto;
            transition: margin-left 0.3s ease;
        }

        .sidebar-section { padding: 0; }

        .sidebar-section-header {
            display: flex;
            align-items: center;
            padding: 14px 20px;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--dark-color);
            cursor: pointer;
            border-bottom: 1px solid #f3f2f1;
            user-select: none;
            transition: background 0.15s;
        }
        .sidebar-section-header:hover { background: #f3f2f1; }

        .sidebar-section-header .bi { font-size: 1.1rem; margin-right: 10px; color: var(--primary-color); }
        .sidebar-section-header .chevron {
            margin-left: auto;
            transition: transform 0.2s;
            font-size: 0.75rem;
            color: #a19f9d;
        }
        .sidebar-section-header.collapsed .chevron { transform: rotate(-90deg); }

        .sidebar-nav { list-style: none; padding: 0; margin: 0; }
        .sidebar-nav li a {
            display: flex;
            align-items: center;
            padding: 10px 20px 10px 48px;
            color: #605e5c;
            text-decoration: none;
            font-size: 0.875rem;
            transition: all 0.15s;
            border-left: 3px solid transparent;
        }
        .sidebar-nav li a:hover {
            background: #f3f2f1;
            color: var(--primary-color);
        }
        .sidebar-nav li a.active {
            background: #deecf9;
            color: var(--primary-color);
            font-weight: 600;
            border-left-color: var(--primary-color);
        }
        .sidebar-nav li a .bi { margin-right: 8px; font-size: 0.95rem; }

        /* ─── Content area ───────────────────────────── */
        .app-wrapper { display: flex; min-height: calc(100vh - 56px); }
        .content-area {
            flex: 1;
            padding: 24px 32px;
            min-width: 0;
            max-width: 100%;
        }

        /* ─── Cards ──────────────────────────────────── */
        .card {
            border: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-radius: 8px;
        }
        .card-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            border-radius: 8px 8px 0 0 !important;
            font-weight: 600;
        }
        .section-card { margin-bottom: 24px; }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
        .btn-primary:hover {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
        }

        .status-badge { padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 500; }
        .status-enabled { background-color: #dff6dd; color: var(--success-color); }
        .status-valid   { background-color: #dff6dd; color: var(--success-color); }
        .status-disabled { background-color: #fde7e9; color: var(--danger-color); }
        .status-revoked  { background-color: #fde7e9; color: var(--danger-color); }
        .status-published { background-color: #deecf9; color: var(--primary-color); }

        .info-label { color: #605e5c; font-size: 0.85rem; font-weight: 500; }
        .info-value { font-weight: 600; word-break: break-all; }
        .action-btn { margin: 2px; }

        .loading-spinner { display: none; }
        .loading .loading-spinner { display: inline-block; }

        .table-hover tbody tr:hover { background-color: #f3f2f1; }

        .modal-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
        }
        .modal-header .btn-close { filter: invert(1); }

        .user-info { display: flex; align-items: center; gap: 10px; }
        .user-avatar {
            width: 32px; height: 32px; border-radius: 50%;
            background-color: white;
            display: flex; align-items: center; justify-content: center;
            color: var(--primary-color); font-weight: bold;
        }

        footer {
            background-color: var(--dark-color);
            color: white;
            padding: 20px 0;
        }

        /* ─── Mobile ─────────────────────────────────── */
        @@media (max-width: 991.98px) {
            .sidebar {
                margin-left: calc(-1 * var(--sidebar-width));
                position: fixed;
                top: 56px;
                z-index: 1020;
                height: calc(100vh - 56px);
            }
            .sidebar.show { margin-left: 0; }
            .sidebar-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                top: 56px;
                background: rgba(0,0,0,0.3);
                z-index: 1019;
            }
            .sidebar.show ~ .sidebar-backdrop { display: block; }
            .content-area { padding: 16px; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid px-3">
            <button class="btn btn-link text-white d-lg-none me-2 p-0" id="sidebarToggle" aria-label="Toggle sidebar">
                <i class="bi bi-list fs-4"></i>
            </button>
            <a class="navbar-brand" href="/">
                <i class="bi bi-shield-lock me-2"></i>
                Entra Admin Dashboard
            </a>
            <div class="d-flex align-items-center ms-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-info text-white me-3">
                        <div class="user-avatar">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <span class="d-none d-md-inline">@User.Identity.Name</span>
                    </div>
                    <a class="btn btn-outline-light btn-sm" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">
                        <i class="bi bi-box-arrow-right me-1"></i><span class="d-none d-sm-inline">Sign Out</span>
                    </a>
                }
                else
                {
                    <a class="btn btn-outline-light btn-sm" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </a>
                }
            </div>
        </div>
    </nav>

    <div class="app-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <!-- Passwordless Section -->
            <div class="sidebar-section">
                <div class="sidebar-section-header" data-section="passwordless">
                    <i class="bi bi-key"></i>
                    Passwordless
                    <i class="bi bi-chevron-down chevron"></i>
                </div>
                <ul class="sidebar-nav" id="nav-passwordless">
                    <li>
                        <a href="/Passwordless/Activity" data-path="/passwordless/activity">
                            <i class="bi bi-graph-up"></i> Activity Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="/Passwordless/Configuration" data-path="/passwordless/configuration">
                            <i class="bi bi-gear"></i> Configuration
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Verified ID Section -->
            <div class="sidebar-section">
                <div class="sidebar-section-header" data-section="verifiedid">
                    <i class="bi bi-shield-check"></i>
                    Verified ID
                    <i class="bi bi-chevron-down chevron"></i>
                </div>
                <ul class="sidebar-nav" id="nav-verifiedid">
                    <li>
                        <a href="/Activity" data-path="/activity">
                            <i class="bi bi-graph-up"></i> Activity Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="/Home" data-path="/home">
                            <i class="bi bi-speedometer2"></i> Configuration
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <div class="sidebar-backdrop d-lg-none" id="sidebarBackdrop"></div>

        <!-- Main Content -->
        <main class="content-area">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container text-center">
            <p class="mb-0">&copy; @DateTime.Now.Year - Entra Admin Dashboard</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar active state
        (function() {
            var path = window.location.pathname.toLowerCase().replace(/\/$/, '') || '/';
            var links = document.querySelectorAll('.sidebar-nav a');
            links.forEach(function(link) {
                var linkPath = (link.getAttribute('data-path') || '').toLowerCase();
                if (linkPath && path.startsWith(linkPath)) {
                    link.classList.add('active');
                    // Ensure parent section is expanded
                    var section = link.closest('.sidebar-section');
                    if (section) {
                        var nav = section.querySelector('.sidebar-nav');
                        if (nav) nav.style.display = 'block';
                    }
                }
            });
            // Default: if on root /, highlight first Verified ID config
            if (path === '/' || path === '/home' || path === '/home/index') {
                var homeLink = document.querySelector('a[data-path="/home"]');
                if (homeLink) homeLink.classList.add('active');
            }
        })();

        // Sidebar section collapse/expand
        document.querySelectorAll('.sidebar-section-header').forEach(function(header) {
            header.addEventListener('click', function() {
                var nav = this.nextElementSibling;
                if (nav && nav.classList.contains('sidebar-nav')) {
                    var isHidden = nav.style.display === 'none';
                    nav.style.display = isHidden ? 'block' : 'none';
                    this.classList.toggle('collapsed', !isHidden);
                }
            });
        });

        // Mobile sidebar toggle
        var sidebarToggle = document.getElementById('sidebarToggle');
        var sidebar = document.getElementById('sidebar');
        var backdrop = document.getElementById('sidebarBackdrop');
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', function() {
                sidebar.classList.toggle('show');
            });
        }
        if (backdrop) {
            backdrop.addEventListener('click', function() {
                sidebar.classList.remove('show');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
